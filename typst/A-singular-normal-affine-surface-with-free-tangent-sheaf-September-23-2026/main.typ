  #[#set math.equation(numbering: n => "(3.6)")
   $ "Res"_C #h(-0.16667em) (frac(e \( y \, z \) thin d y and d z, k \( y \, z \))) =
     frac(e \|_C, k_y \|_C) thin d z . $ <trace:adjunction>]
