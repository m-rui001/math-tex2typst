  content((0, 0), [$Z_(n,q)$#linebreak()$h=q+3-3n$])
  content((-3.1, -2), [$Z_(n,q-1)$#linebreak()$h-1$ holes])
  content((3.1, -2), [$Z_(n-1,q-3)$#linebreak()$h$ holes])
  line((-0.761, -0.491), (-2.369, -1.529), stroke: (thickness: 0.4pt, miter-limit: 10), mark: (end: (symbol: ">>", fill: black)))
  line((0.761, -0.491), (2.402, -1.55), stroke: (thickness: 0.4pt, miter-limit: 10), mark: (end: (symbol: ">>", fill: black)))
  content((-2.1, -0.8), [$F$: record a flag#linebreak()at $q$], anchor: "east", padding: 0.1176cm)
