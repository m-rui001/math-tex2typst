  #[#set math.equation(numbering: n => "(7.18)")
   $ "rank" #scale(x: 120%, y: 120%)[\(] upright("column map at a diagonal point") #scale(x: 120%, y: 120%)[\)] lt.eq p^(n t) #scale(x: 120%, y: 120%)[\(] \( 2 b_0 \)^n H^n + O \( p^(- 1) \) #scale(x: 120%, y: 120%)[\)] lt.eq R \/ 4 $ <eq:diag-rank-loss>]
