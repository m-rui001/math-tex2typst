  [#cetz.canvas({
  import cetz.draw: *
  content((0, 0), [#box(width: 0.7cm, height: 0.7cm, inset: 0.3333em, radius: 2pt, stroke: (paint: rgb("#0000a6"), thickness: 0.4pt, miter-limit: 10), fill: rgb("#e6e6ff"), [#set text(hyphenate: false); #align(center + horizon)[$a$]])])
  content((-1.08, 0.99), [#box(width: 0.7cm, height: 0.7cm, inset: 0.3333em, radius: 2pt, stroke: (paint: rgb("#0000a6"), thickness: 0.4pt, miter-limit: 10), fill: rgb("#e6e6ff"), [#set text(hyphenate: false); #align(center + horizon)[$b$]])])
  content((0.8325, 0.7425), (1.327, 1.237), [#set text(hyphenate: false); #align(center + horizon)[$y$]], frame: "circle", stroke: (thickness: 0.4pt, miter-limit: 10))
  content((-0.2475, 1.733), (0.2475, 2.227), [#set text(hyphenate: false); #align(center + horizon)[$x$]], frame: "circle", stroke: (thickness: 0.4pt, miter-limit: 10))
  line((-0.35, 0.3208), (-0.73, 0.6692), stroke: (thickness: 0.4pt, miter-limit: 10), mark: (end: (symbol: ">>", fill: black)))
  line((0.35, 0.3208), (0.8168, 0.7487), stroke: (thickness: 0.4pt, miter-limit: 10), mark: (end: (symbol: ">>", fill: black)))
  line((-0.73, 1.311), (-0.2632, 1.739), stroke: (thickness: 0.4pt, miter-limit: 10), mark: (end: (symbol: ">>", fill: black)))
