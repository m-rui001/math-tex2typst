  content((2.391, -0.744), [$V .$])
  line((0.864, 0), (2.055, 0), mark: (end: ">"))
  content((1.46, 0.2266), [#text(size: 0.73em)[$- hat(⊗)_(cal(E)^(\( b \))) P^(\( b \))$]])
  line((0, -0.2725), (0, -0.4715), mark: (end: ">"))
  content((1.238, -0.372), [#text(size: 0.73em)[$upright("forget factors ") 2 \, dots.h \, b$]])
  line((0.6, -0.744), (1.989, -0.744), mark: (end: ">"))
