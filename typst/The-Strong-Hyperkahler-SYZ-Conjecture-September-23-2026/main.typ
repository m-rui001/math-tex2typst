  content((0, 2.438), [#text(size: 9pt)[$[ omega_K] in bb(R)_(>0)(v-a lambda e)$]], anchor: "south", padding: 0.1176cm)
  content((-1.168, 0.7176), [#text(size: 9pt)[period plane#linebreak()for $I$]])
