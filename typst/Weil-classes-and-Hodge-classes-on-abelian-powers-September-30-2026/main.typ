  #[#set math.equation(numbering: n => "(4.23)")
   $ cal(O)_(cal(C)) \( E_i \) \|_(E_i) = cal(O)_(E_i) \( - e_i \) \, quad cal(O)_(cal(C)) \( E_i \) \|_R = cal(O)_R \( e_i \) \, quad cal(O)_(cal(C)) \( E_i \) \|_(E_j) = cal(O)_(E_j) quad \( j eq.not i \) . $ <p3sw:support-tail-twist>]
