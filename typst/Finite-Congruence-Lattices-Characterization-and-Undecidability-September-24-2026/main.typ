],
  table.cell(rowspan: 1, colspan: 1)[Bottom condition
], table.cell(rowspan: 1, colspan: 1)[173
], table.cell(rowspan: 1, colspan: 1)[68
], table.cell(rowspan: 1, colspan: 1)[4
],
