  #[#set math.equation(numbering: n => "(8.16)")
   $ parallel A^(1 \/ 2) - B^(1 \/ 2) parallel_2^2 lt.eq parallel A - B parallel_1 quad \( A \, B gt.eq 0 \) . $ <eq:scale-square-root>]
